<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Config
  - Blocks all cleartext (HTTP) traffic in release
  - Only HTTPS connections allowed
  - No user-installed CA certificates trusted (release hardening)
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Trust only system CAs in release; user-installed CAs ignored -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Allow cleartext only for localhost during debug -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>
